#: lib/method/PACMethod_3270.pm:210
msgid " Select display model: "
msgstr " Seleziona il modello di display:"

#: lib/method/PACMethod_3270.pm:211
msgid ""
"[-model (3278|3279)-(2|3|4|5)] : Selects a display model(3278 BW , 3279 "
"Colour, with different number of rows and columns"
msgstr ""
"[-model (3278|3279)-(2|3|4|5)] : sceglie un modello di display (3278 B/N, "
"3279 a colori, con numero diverso di righe e colonne"

#: lib/method/PACMethod_3270.pm:243
msgid " Connect method: "
msgstr " Metodo di connessione:"

#: lib/method/PACMethod_3270.pm:249
msgid "Standard"
msgstr "Standard"

#: lib/method/PACMethod_3270.pm:251
msgid ""
"Do not prepend any character [P|S|N|L] to the host. That is, do a standard "
"connection."
msgstr ""
"Non premettere nessun carattere [P|S|N|L] all'host, cioè fai una connessione "
"standard."

#: lib/method/PACMethod_3270.pm:253
msgid "Telnet-passthru"
msgstr "Telnet-passthru"

#: lib/method/PACMethod_3270.pm:255
msgid ""
"[P:] : causes the connection to go through the telnet-passthru service "
"rather than directly to the host."
msgstr ""
"[P:] : fa passare la connessione dal servizio telnet-passthru invece che "
"direttamente all'host."

#: lib/method/PACMethod_3270.pm:257
msgid "NO Extended Data Stream"
msgstr "NIENTE Extended Data Stream"

#: lib/method/PACMethod_3270.pm:259
msgid ""
"[S:] : Removes the \"extended data stream\" option reported to the host."
msgstr "[S:] : toglie l'opzione \"extended data stream\" comunicata all'host."

#: lib/method/PACMethod_3270.pm:261
msgid "NO TN3270E support"
msgstr "NIENTE supporto TN3270E"

#: lib/method/PACMethod_3270.pm:263
msgid "[N:] : Turns off TN3270E support for the session."
msgstr "[N:] : disattiva il supporto TN3270E per la sessione."

#: lib/method/PACMethod_3270.pm:265
msgid "Use SSL Tunnel"
msgstr "Usa un tunnel SSL"

#: lib/method/PACMethod_3270.pm:267
msgid ""
"[L:] : Causes c3270 to first create an SSL tunnel to the host, and then "
"create a TN3270 session inside the tunnel."
msgstr ""
"[L:] : fa creare a c3270 prima un tunnel SSL verso l'host, poi una sessione "
"TN3270 dentro il tunnel."

#: lib/method/PACMethod_3270.pm:274
msgid "ALL characters in bold"
msgstr "TUTTI i caratteri in grassetto"

#: lib/method/PACMethod_3270.pm:276
msgid "[-allbold] : Forces all characters to be displayed in bold."
msgstr "[-allbold] : mostra tutti i caratteri in grassetto."

#: lib/method/PACMethod_3270.pm:278
msgid "Use cbreak mode"
msgstr "Usa la modalità cbreak"

#: lib/method/PACMethod_3270.pm:280
msgid ""
"[-cbreak] : Causes c3270 to operate in cbreak mode, instead of raw mode."
msgstr "[-cbreak] : fa funzionare c3270 in modalità cbreak invece che raw."

#: lib/method/PACMethod_3270.pm:282
msgid "Disable command-prompt mode"
msgstr "Disattiva la modalità prompt dei comandi"

#: lib/method/PACMethod_3270.pm:284
msgid "[-noprompt] : Disables command-prompt mode."
msgstr "[-noprompt] : disattiva la modalità prompt dei comandi."

#: lib/method/PACMethod_3270.pm:286
msgid "Force Monochrome"
msgstr "Forza il monocromatico"

#: lib/method/PACMethod_3270.pm:288
msgid ""
"[-mono] : Prevents c3270 from using color, ignoring any color capabilities "
"reported by the terminal."
msgstr ""
"[-mono] : impedisce a c3270 di usare i colori, ignorando le capacità di "
"colore del terminale."

#: lib/method/PACMethod_3270.pm:295
msgid "EBCDIC character set:"
msgstr "Set di caratteri EBCDIC:"

#: lib/method/PACMethod_3270.pm:299
msgid "[-charset <name>] : Specifies an EBCDIC host character set."
msgstr "[-charset <name>] : indica il set di caratteri EBCDIC dell'host."

#: lib/method/PACMethod_3270.pm:302
msgid " Input Method:"
msgstr " Metodo di input:"

#: lib/method/PACMethod_3270.pm:306
msgid ""
"[-im <method>] : Specifies the name of the input method to use for multi-"
"byte input."
msgstr ""
"[-im <method>] : indica il nome del metodo di input da usare per l'input "
"multibyte."

#: lib/method/PACMethod_3270.pm:312
msgid "Keyboard Map:"
msgstr "Mappa della tastiera:"

#: lib/method/PACMethod_3270.pm:316
msgid ""
"[-keymap <name>] : Specifies a keyboard map to be found in the resource "
"c3270.keymap.name or the file name."
msgstr ""
"[-keymap <name>] : indica una mappa della tastiera da cercare nella risorsa "
"c3270.keymap.name o nel file name."

#: lib/method/PACMethod_3270.pm:319
msgid " Printer LU:"
msgstr " LU della stampante:"

#: lib/method/PACMethod_3270.pm:323
msgid ""
"[-printerlu <luname>] : Causes c3270 to automatically start a pr3287 printer "
"session."
msgstr ""
"[-printerlu <luname>] : fa avviare a c3270 automaticamente una sessione di "
"stampa pr3287."

#: lib/method/PACMethod_3270.pm:329
msgid "Terminal Name:"
msgstr "Nome del terminale:"

#: lib/method/PACMethod_3270.pm:333
msgid ""
"[-tn <name>] : Specifies  the terminal name to be transmitted over the "
"telnet connection.  The default name is IBM-model_name-E."
msgstr ""
"[-tn <name>] : indica il nome del terminale da trasmettere sulla connessione "
"telnet. Il nome predefinito è IBM-model_name-E."

#: lib/method/PACMethod_cadaver.pm:159
msgid "Tolerant mode"
msgstr "Modalità tollerante"

#: lib/method/PACMethod_cadaver.pm:161
msgid ""
"[-t] : Allow cd/open into non-WebDAV enabled collection; use if the server "
"or proxy server has WebDAV compliance problems."
msgstr ""
"[-t] : permette cd/open in raccolte non abilitate a WebDAV; usalo se il "
"server o il proxy hanno problemi di conformità WebDAV."

#: lib/method/PACMethod_cu.pm:187
msgid "Line: "
msgstr "Linea:"

#: lib/method/PACMethod_cu.pm:190
msgid "[-l|--line] : Line to use to connect. Ex: /dev/ttyUSB0"
msgstr "[-l|--line] : linea da usare per connettersi. Es.: /dev/ttyUSB0"

#: lib/method/PACMethod_cu.pm:192
msgid " Speed: "
msgstr " Velocità:"

#: lib/method/PACMethod_cu.pm:195
msgid "[-s|--speed] : Speed to use to connect. Ex: 9660"
msgstr "[-s|--speed] : velocità da usare per connettersi. Es.: 9660"

#: lib/method/PACMethod_cu.pm:198
msgid " Port: "
msgstr " Porta:"

#: lib/method/PACMethod_cu.pm:201
msgid "[-p|--port] : Port to connect"
msgstr "[-p|--port] : porta a cui connettersi"

#: lib/method/PACMethod_cu.pm:203
msgid " Parity: "
msgstr " Parità:"

#: lib/method/PACMethod_cu.pm:205
msgid "-(e|o|none) : Use 'even', 'odd' or 'no' parity"
msgstr "-(e|o|none) : usa parità 'pari', 'dispari' o nessuna"

#: lib/method/PACMethod_cu.pm:212
msgid "Half Duplex"
msgstr "Half duplex"

#: lib/method/PACMethod_cu.pm:214
msgid "[-h] : Echo characters locally (half-duplex mode)"
msgstr "[-h] : mostra i caratteri in locale (modalità half-duplex)"

#: lib/method/PACMethod_cu.pm:216
